{
  "schema_version": 1,
  "description": "超哥公开口播的项目级语言失败样本与历史锚点规则。规则由用户明确否决的真实稿件生成，不是通用敏感词表。",
  "history_manifest": "<project-root>/workflow/recent-content-history.v1.json",
  "ai_tone_rules": [
    {
      "id": "editorial-capacity-boundary",
      "pattern": "这里说的是.{0,24}(?:产能|数据|口径).{0,16}(?:不是|不等于).{0,24}(?:销量|产量|结果)",
      "description": "事实锁的编辑备注泄漏进口播正文"
    },
    {
      "id": "reported-source-scaffold",
      "pattern": "公开报道(?:里|中).{0,120}(?:现场|对标|口径)",
      "description": "用来源标签和口径说明拼接正文"
    },
    {
      "id": "stacked-onsite-attribution",
      "pattern": "我在现场看到.{0,180}(?:讲解中|现场讲解).{0,10}提到",
      "description": "同一段叠加‘我看到’和‘讲解提到’两层来源证明"
    },
    {
      "id": "meta-rethink-scaffold",
      "pattern": "我(?:又|重新).{0,12}把.{0,28}(?:重新看|重新理解|再看).{0,12}(?:一遍|一次)?",
      "description": "用假性思考过程代替直接判断"
    },
    {
      "id": "meta-interpret-scaffold",
      "pattern": "我更愿意(?:把|将).{0,36}(?:理解|看)成",
      "description": "使用通用解释支架，没有直接给出本人判断"
    },
    {
      "id": "onsite-source-label-scaffold",
      "pattern": "(?:(?:这是|这就是).{0,24}(?:参访|走访).{0,20}(?:现场)?(?:说法|口径)|(?:参访|走访).{0,24}(?:现场(?:的)?|讲解(?:的)?)?(?:说法|口径)(?:是|为))",
      "description": "把来源标签或审稿口径当成口播正文，没有直接进入事实或判断"
    },
    {
      "id": "attention-directing-transition",
      "pattern": "(?:(?:这个|这组|这些)?(?:数字|数据|性能).{0,24}(?:先)?(?:把|让).{0,20}(?:大家|观众)?(?:的)?注意力.{0,20}(?:放到|拉到|集中到|转向|到了).{0,20}(?:芯片|数字|数据|性能)|(?:先用|先拿).{0,12}(?:这个数|这组数据|数字|数据).{0,20}(?:把|让).{0,20}(?:大家|观众)?(?:的)?注意力.{0,16}(?:放到|拉到|集中到|转向))",
      "description": "用写作转场指挥观众注意力，句子本身没有新信息"
    },
    {
      "id": "public-source-label-scaffold",
      "pattern": "公开(?:资料|信息|报道|材料)(?:里|中)?(?:说|显示|提到|写道|称|介绍)",
      "description": "只念‘公开资料’等泛化来源标签，没有直接说清事实及其作用"
    },
    {
      "id": "banal-nonexpert-scaffold",
      "pattern": "(?:大多数|多数|很多|普通)(?:人|从业者).{0,20}(?:既)?(?:不会|不懂|不做|不负责|不造).{0,24}(?:芯片|芯片设计).{0,40}(?:也|又|更).{0,16}(?:不会|不懂|不做|不负责|不造|造不了|造).{0,24}(?:服务器|服务器生产)",
      "description": "用显而易见的‘普通人不做专业硬件’充当观众转场，没有提供新判断"
    }
  ],
  "anchor_rules": [
    {
      "id": "qingyang-compute",
      "pattern": "(?:庆阳.{0,20}(?:算力|数据中心|枢纽)|(?:算力|数据中心|枢纽).{0,20}庆阳)",
      "description": "庆阳算力、数据中心或国家枢纽锚点",
      "block_if_latest_match": true
    }
  ]
}
