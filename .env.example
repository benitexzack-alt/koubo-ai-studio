# 复制为本机 .env 后填写；不要提交、不要发到聊天里。

# ElevenLabs 转写 API Key
ELEVENLABS_API_KEY=

# 可选：如果后续接中转站生图/图生图，再填写
IMAGE_API_TYPE=openai-compatible
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_EDIT_MODEL=
IMAGE_API_TIMEOUT_MS=120000

# 可选：项目专用完整 FFmpeg；默认脚本会优先尝试这个路径
FFMPEG_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_BIN=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
