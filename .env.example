# 复制为本机 .env 后填写；不要提交、不要发到聊天里。

# ElevenLabs 转写 API Key
ELEVENLABS_API_KEY=

# 可选：如果后续接中转站生图/图生图，再填写
IMAGE_API_TYPE=openai-compatible
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_EDIT_MODEL=
IMAGE_API_TIMEOUT_MS=120000

# 可选：默认从 PATH 调用 ffmpeg / ffprobe；只有多版本共存时才填写绝对路径
FFMPEG_BIN=
FFPROBE_BIN=
