# 复制为本机 .env 后填写；不要提交、不要发到聊天里。

# ElevenLabs 转写 API Key
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=scribe_v2
ELEVENLABS_TIMEOUT_MS=1800000

# 可选：素材抠图与图片/视频升清；真实调用前仍需逐次确认外部上传和费用
EACHLABS_API_KEY=

# 可选：纸构推演自动插片调用 RunningHub；只放本机环境，报价后仍需逐计划金额授权
RUNNINGHUB_API_KEY=

# 可选：如果后续接中转站生图/图生图，再填写
IMAGE_API_TYPE=openai-compatible
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_EDIT_MODEL=
IMAGE_API_TIMEOUT_MS=120000

# 可选：默认从 PATH 调用 ffmpeg / ffprobe；只有多版本共存时才填写绝对路径
FFMPEG_BIN=
FFPROBE_BIN=
