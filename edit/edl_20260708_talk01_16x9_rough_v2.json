{
  "sources": {
    "IMG_20260708_talk01_16x9": "../source/IMG_20260708_talk01_16x9.MOV"
  },
  "grade": "eq=contrast=1.035:saturation=1.02:brightness=0.01",
  "ranges": [
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 1.44,
      "end": 4.64,
      "beat": "HOOK",
      "quote": "甘肃开实体店的老板别再被 AI 忽悠了。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 5.34,
      "end": 29.12,
      "beat": "POSITIONING",
      "quote": "我只关心一件事，AI 到底能不能帮咱们本地的小微企业解决点真的问题。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 29.72,
      "end": 42.5,
      "beat": "LOCAL_EXAMPLES",
      "quote": "餐饮店、家具店、工厂，怎么用 AI 做具体动作。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 43,
      "end": 57.98,
      "beat": "ANTI_SYSTEM",
      "quote": "小企业用 AI，第一步真不是买系统。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 58.34,
      "end": 64.76,
      "beat": "ONE_TASK",
      "quote": "就挑一件小事，让 AI 先跑一周。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 65.48,
      "end": 76.48,
      "beat": "THREE_CHECKS",
      "quote": "省没省时间，漏没漏跟进，改一改能不能用。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 77.02,
      "end": 82.7,
      "beat": "ROOT_CAUSE",
      "quote": "不行，也别怪 AI，大概率是资料太乱太少。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 83.68,
      "end": 89.44,
      "beat": "PUBLIC_RECORD",
      "quote": "从兰州出发，公开记录用 AI 服务本地企业的全过程。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 89.98,
      "end": 94.8,
      "beat": "TRUTH_PROMISE",
      "quote": "做成了讲透，做不成把坑说清楚。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 95.8,
      "end": 99.18,
      "beat": "NO_HYPE",
      "quote": "不承诺变现，不造风口神话。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 99.92,
      "end": 104.22,
      "beat": "LANDING",
      "quote": "把 AI 从概念落到实打实的业务里。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 105.38,
      "end": 109.08,
      "beat": "HALF_HOUR",
      "quote": "先别追风口，先让 AI 帮你省下半小时。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 110.46,
      "end": 116.1,
      "beat": "CODEX_PROOF",
      "quote": "这条视频的文稿、字幕、剪辑也都是 Codex 辅助完成的。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 117.12,
      "end": 124.32,
      "beat": "OWN_PRACTICE",
      "quote": "我不是只讲落地，我自己也先这么干，这就是我在兰州做 AI 创业的第一步。"
    },
    {
      "source": "IMG_20260708_talk01_16x9",
      "start": 125.1,
      "end": 130.16,
      "beat": "CTA",
      "quote": "想看我接下来怎么跑？点个关注，咱们一起踩坑，一起落地。"
    }
  ],
  "overlays": []
}
