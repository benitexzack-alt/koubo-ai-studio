  "paperUsage": [
    {
      "sceneId": "P01",
      "beatId": "B04",
      "title": "经验留下来，客户了解用起来",
      "sourceQuote": "所以，你以前做过销售、开过店，或者在一个行业干了很多年，别觉得学AI就得把这些全扔了，从头转行。你对客户的了解，恰恰可能派上用场。",
      "durationSeconds": 7,
      "timeline": "pending-recorded-audio"
    },
    {
      "sceneId": "P02",
      "beatId": "B07",
      "title": "回答整理成内容，必须经过老板核对",
      "sourceQuote": "你可以帮他把这些回答收集起来，用AI归类、理顺，改成适合拍视频的文稿，再由老板核对。配上能公开的产品和服务资料，一条条讲出去。AI承担整理和制作里的部分工作，内容的底子，还是老板自己做过的生意。",
      "durationSeconds": 8,
      "timeline": "pending-recorded-audio"
    },
    {
      "sceneId": "P03",
      "beatId": "B10",
      "title": "只有内容，缺产品服务就接不住",
      "sourceQuote": "这既是老板可以尝试的内容做法，也给懂这个行业的人留出了一种服务机会。你帮他把经验讲清楚、持续做成内容，省下他自己摸索和制作的工夫。但他本身没有能交给客户的产品或服务，光发内容也接不住生意。",
      "durationSeconds": 6,
      "timeline": "pending-recorded-audio"
    },
    {
      "sceneId": "P04",
      "beatId": "B11",
      "title": "向外地介绍服务，不是订单自动到来",
      "sourceQuote": "如果你能听懂一个行业的问题，也能把约定的工作做好，就可以试着把这项服务介绍给外地同行。同样需要整理客户问题、制作产品内容的人。",
      "durationSeconds": 7,
      "timeline": "pending-recorded-audio"
    },
    {
      "sceneId": "P05",
      "beatId": "B15",
      "title": "不是零成本，留出继续尝试的余地",
      "sourceQuote": "我自己学AI，课程、会员、调用费用、做图做视频的成本都花过。做出来不合适，还得继续改。所以我不会把这条路讲成一台电脑、零成本创业。钱花得少一些，只是让你有机会多试几次。",
      "durationSeconds": 7,
      "timeline": "pending-recorded-audio"
    },
    {
      "sceneId": "P06",
      "beatId": "B17",
      "title": "服务先说清楚范围、协作和交付",
      "sourceQuote": "你得听得懂老板说的麻烦，不能他一说生意不好，你就给他生成一份通用方案。AI给出的内容，也得看得出哪里不符合实际。到了收服务费的时候，还要把做哪些工作、谁配合、交什么东西讲清楚。客户拿到以后用不上，你得能继续查问题。",
      "durationSeconds": 6,
      "timeline": "pending-recorded-audio"
    }
