      "startFrame": 384,
      "endFrameExclusive": 602,
      "sourceSegments": [
        6,
        9
      ],
      "route": "ai-generated-video",
      "cueId": "G01",
      "reason": "一个员工的克制摇头让会议气氛具体可见；脸部社交反应适合人物情景，纸艺会削弱含义。情景不证明所有员工如此。"
    },
    {
      "id": "B05",
      "scriptQuoteComparisonOnly": "可背地里呢？",
      "quote": "可背地里",
      "start": 20.08,
      "end": 21.1,
      "startFrame": 602,
      "endFrameExclusive": 633,
      "sourceSegments": [
        10,
        10
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "回到本人，用短停顿把观众从会议带到私下使用。"
    },
    {
      "id": "B06",
      "scriptQuoteComparisonOnly": "下班回家练Z6、练Cursor、练Codex，",
      "quote": "下班回家练Z6Cursor和Codex",
      "start": 21.1,
      "end": 24.52,
      "startFrame": 633,
      "endFrameExclusive": 736,
      "sourceSegments": [
        10,
        11
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "工具名只是原稿列举，并非本条工具教学；Z6待明确，不伪造界面或标志。"
    },
    {
      "id": "B07",
      "scriptQuoteComparisonOnly": "上班老板一转身，工具一开，",
      "quote": "上班老板一转身工具一开",
      "start": 24.92,
      "end": 27.42,
      "startFrame": 748,
      "endFrameExclusive": 823,
      "sourceSegments": [
