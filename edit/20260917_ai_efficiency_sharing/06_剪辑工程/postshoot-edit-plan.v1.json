  "beats": [
    {
      "id": "B01",
      "scriptQuoteComparisonOnly": "做企业AI落地这么久，我发现一个特别有意思的职场默契：",
      "quote": "做企业AI落地这么久我发现一个特别有意思的职场默契",
      "start": 0,
      "end": 4.2,
      "startFrame": 0,
      "endFrameExclusive": 126,
      "sourceSegments": [
        0,
        1
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "本人正面建立讲述身份；经历只视作用户自述，未添加客户或年限。"
    },
    {
      "id": "B02",
      "scriptQuoteComparisonOnly": "一家公司里，真正会用AI的人，全在集体装不会。",
      "quote": "一家公司里真正会用AI的人全在集体装不会",
      "start": 4.2,
      "end": 8.36,
      "startFrame": 126,
      "endFrameExclusive": 251,
      "sourceSegments": [
        2,
        3
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "钩子需要眼神和停顿；全称判断缺证据，不能用群像画面制造调查成立的错觉。"
    },
    {
      "id": "B03",
      "scriptQuoteComparisonOnly": "表面上大家得过且过，敲代码改方案全靠手动；",
      "quote": "表面上大家得过且过敲代码改方案全靠手动",
      "start": 8.759999999999998,
      "end": 12.8,
      "startFrame": 263,
      "endFrameExclusive": 384,
      "sourceSegments": [
        4,
        5
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "用表情讲反差，避免把无证据的员工态度拍成真实公司记录。"
    },
    {
      "id": "B04",
      "scriptQuoteComparisonOnly": "老板开AI研讨会，所有人齐刷刷摇头，说这东西不靠谱、误差大、没法落地。",
      "quote": "老板开AI研讨会所有人齐刷刷摇头这个东西不靠谱误差大没法落地",
      "start": 12.8,
