        13
      ],
      "route": "ai-generated-video",
      "cueId": "G02",
      "reason": "把电脑轻轻转向自己可表达隐蔽动作；具体视线关系不适合抽象纸艺。屏幕没有可读界面，不证明真实使用行为。"
    },
    {
      "id": "B08",
      "scriptQuoteComparisonOnly": "十分钟干完一天的活，然后继续潜水，深藏功与名。",
      "quote": "10分钟干完一天的活然后继续潜水深藏功与名",
      "start": 27.42,
      "end": 32.26,
      "startFrame": 823,
      "endFrameExclusive": 968,
      "sourceSegments": [
        14,
        16
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "回真人承接原句；没有耗时试验，不做计时器、进度突变或前后成绩动画。"
    },
    {
      "id": "B09",
      "scriptQuoteComparisonOnly": "全公司心照不宣：嘴上都说AI不行，私下个个都在偷偷提速。",
      "quote": "全公司心照不宣嘴上都说AI不行私下个个都在偷偷提速",
      "start": 32.760000000000005,
      "end": 39.32,
      "startFrame": 983,
      "endFrameExclusive": 1180,
      "sourceSegments": [
        17,
        19
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "保留本人总结；重复全称不能靠更多情景镜头加强事实感。"
    },
    {
      "id": "B10",
      "scriptQuoteComparisonOnly": "很多老板觉得这是员工懒、不配合，",
      "quote": "很多老板觉得这是员工懒不配合",
      "start": 39.32,
      "end": 43.62,
      "startFrame": 1180,
      "endFrameExclusive": 1309,
      "sourceSegments": [
        20,
        21
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "由本人说出被质疑的归因，不刻画具体老板，不把管理者表演成反派。"
    },
    {
      "id": "B11",
      "scriptQuoteComparisonOnly": "我实话告诉你——这根本不是人的问题，这是机制的问题。",
      "quote": "我实话告诉你这根本不是人的问题这是机制的问题",
      "start": 43.62,
      "end": 48.92,
      "startFrame": 1309,
      "endFrameExclusive": 1468,
      "sourceSegments": [
        22,
        24
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "正面强调机制；排除其他原因的绝对因果另行核验，视觉只聚焦已有原话。"
    },
    {
      "id": "B12",
      "scriptQuoteComparisonOnly": "你换个角度想：员工公开用AI，效率翻三倍，结果是什么？",
      "quote": "你换个角度想员工会用AI效率翻三倍结果是什么",
      "start": 48.92,
      "end": 56.32,
      "startFrame": 1468,
      "endFrameExclusive": 1690,
      "sourceSegments": [
        25,
        28
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "这是以你换个角度想引出的假设场景；三倍仍单列核验，不包装成实测增幅。"
    },
    {
      "id": "B13",
      "scriptQuoteComparisonOnly": "是加薪吗？是减负吗？\n都不是。",
      "quote": "是加薪吗是减负吗都不是",
      "start": 56.32,
      "end": 59.6,
      "startFrame": 1690,
      "endFrameExclusive": 1788,
      "sourceSegments": [
        29,
        31
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "两个问题和否定回答由表演承担；承接假设情景，不展示假工资单或薪酬数据。"
    },
    {
      "id": "B14",
      "scriptQuoteComparisonOnly": "大概率是老板一句“效率这么高，那再多加两个项目”，",
      "quote": "那么大概率是老板一句效率这么高那再多加两个项目",
      "start": 59.6,
      "end": 65.66,
      "startFrame": 1788,
      "endFrameExclusive": 1970,
      "sourceSegments": [
        32,
        34
      ],
      "route": "paper-editorial",
      "cueId": "P01",
      "reason": "新增文件占据工位余量，直观说明增效被继续加量的机制；概率和两个项目仍是原文假设，不是统计。"
    },
    {
      "id": "B15",
      "scriptQuoteComparisonOnly": "最后活越干越多，工资一分没涨。",
      "quote": "最后呢活越干越多工资一分没涨",
      "start": 65.66,
      "end": 69.94,
      "startFrame": 1970,
      "endFrameExclusive": 2098,
      "sourceSegments": [
        35,
        36
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "切回本人收束后果；不重复纸艺动作，不用虚构工资单证明薪酬不变。"
    },
    {
      "id": "B16",
      "scriptQuoteComparisonOnly": "换你你也藏着用。",
      "quote": "换你你也藏着用",
      "start": 69.94,
      "end": 71.84,
      "startFrame": 2098,
      "endFrameExclusive": 2155,
      "sourceSegments": [
        37,
        38
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "直视镜头，把反问交还观众，避免插片切走情绪。"
    },
    {
      "id": "B17",
      "scriptQuoteComparisonOnly": "所以我们做企业AI落地，从来不是把工具买回来、发个通知就完事了。",
      "quote": "所以我们做企业AI落地从来不是把工具买回来发个通知就完事了",
      "start": 72.71999999999998,
      "end": 78.76,
      "startFrame": 2182,
      "endFrameExclusive": 2363,
      "sourceSegments": [
        39,
        42
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "以用户表达的工作理念处理，不额外添加已实施客户案例或成果。"
    },
    {
      "id": "B18",
      "scriptQuoteComparisonOnly": "你真正要解决的核心问题只有一个：效率提升之后，省出来的时间和产能，到底怎么分配？",
      "quote": "你真正要解决的核心问题只有一个效率提升之后省出来的时间和产能到底怎么分配",
      "start": 78.76,
      "end": 85.52,
      "startFrame": 2363,
      "endFrameExclusive": 2566,
      "sourceSegments": [
        43,
        47
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "这是全片最重要的判断，需要观众看着本人听清分配问题，保留完整问句。"
    },
    {
      "id": "B19",
      "scriptQuoteComparisonOnly": "是全部摊成新的工作量，还是让员工分享增效的红利？",
      "quote": "是全部摊成新的工作量还是让员工分享增效的红利",
      "start": 85.52,
      "end": 92.36,
      "startFrame": 2566,
      "endFrameExclusive": 2771,
      "sourceSegments": [
        48,
        49
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "两种分配方式是价值选择，真人提问已能表达，后续建议再用具体纸艺展开。"
    },
    {
      "id": "B20",
      "scriptQuoteComparisonOnly": "是把AI变成压榨员工的新工具，还是变成整个组织降本增收的武器？",
      "quote": "是把AI变成压榨员工的新工具还是变成整个组织降本增收的武器",
      "start": 92.36,
      "end": 98.7,
      "startFrame": 2771,
      "endFrameExclusive": 2961,
      "sourceSegments": [
        50,
        52
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "比喻由本人声音承担，不画武器、冲突或具体企业侵害行为。"
    },
    {
      "id": "B21",
      "scriptQuoteComparisonOnly": "给所有想推AI的老板三个建议：",
      "quote": "给所有想做AI的老板三个建议",
      "start": 98.7,
      "end": 102.9,
      "startFrame": 2961,
      "endFrameExclusive": 3087,
      "sourceSegments": [
        53,
        53
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "本人转入建议段，让观众清楚接下来是三项行动。"
    },
    {
      "id": "B22",
      "scriptQuoteComparisonOnly": "第一，别搞“AI提速=加量不加价”，",
      "quote": "第一呢就是别搞AI提效等于加量不加价",
      "start": 102.9,
      "end": 107.24,
      "startFrame": 3087,
      "endFrameExclusive": 3217,
      "sourceSegments": [
        54,
        57
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "先在真人上讲清第一条，纸艺只解释随后工时余量。"
    },
    {
      "id": "B23",
      "scriptQuoteComparisonOnly": "省下来的工时，要给员工留冗余，而不是无限堆活；",
      "quote": "省下的工时要给员工冗余而不是无限堆活",
      "start": 107.24,
      "end": 112.3,
      "startFrame": 3217,
      "endFrameExclusive": 3369,
      "sourceSegments": [
        58,
        61
      ],
      "route": "paper-editorial",
      "cueId": "P02",
      "reason": "边界挡板把工作块和空余段隔开，说明需要有明确受保护的工时余量。"
    },
    {
      "id": "B24",
      "scriptQuoteComparisonOnly": "第二，建立增效分成机制，用AI省下的成本，拿出一部分反哺团队，",
      "quote": "第二呢就是建立增效分成机制用AI省下的成本拿出一部分来反哺团队",
      "start": 112.3,
      "end": 119.08,
      "startFrame": 3369,
      "endFrameExclusive": 3572,
      "sourceSegments": [
        62,
        65
      ],
      "route": "paper-editorial",
      "cueId": "P03",
      "reason": "一块已有纸块从组织端移向团队端，说明分享部分收益；不暗示固定分成比例或保证有现金节省。"
    },
    {
      "id": "B25",
      "scriptQuoteComparisonOnly": "大家才有动力公开用、全力推；",
      "quote": "大家才有动力公开用全力推",
      "start": 119.08,
      "end": 122.94,
      "startFrame": 3572,
      "endFrameExclusive": 3688,
      "sourceSegments": [
        66,
        68
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "回真人解释希望得到的行为变化，动力与分成之间的因果不可视为必然效果。"
    },
    {
      "id": "B26",
      "scriptQuoteComparisonOnly": "第三，把个人偷偷用的AI能力，变成标准化的组织工作流，统一培训、统一工具、统一交付，而不是靠员工私下内卷。",
      "quote": "第三呢就是把个人偷偷用的AI能力变成标准化的组织工作流统一培训统一工具统一交付而不是靠员工私下内卷",
      "start": 123.42,
      "end": 134,
      "startFrame": 3703,
      "endFrameExclusive": 4020,
      "sourceSegments": [
        69,
        76
      ],
      "route": "paper-editorial",
      "cueId": "P04",
      "reason": "三个站点由一块连接板接通，说明能力需要接入同一个流程；培训、工具、交付均用原稿节点。"
    },
    {
      "id": "B27",
      "scriptQuoteComparisonOnly": "AI落地，拼的从来不是谁的工具更先进。",
      "quote": "AI落地拼的从来不是谁的工具更先进",
      "start": 134,
      "end": 137.5,
      "startFrame": 4020,
      "endFrameExclusive": 4125,
      "sourceSegments": [
        77,
        78
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "回到本人，不用产品排行榜或性能比较图强化修辞。"
    },
    {
      "id": "B28",
      "scriptQuoteComparisonOnly": "拼的是你能不能把“员工偷偷摸鱼的工具”，变成“企业和员工共赢的生产力”。",
      "quote": "拼的是你能不能把员工偷偷摸鱼的工具变成企业和员工共赢的生产力",
      "start": 137.5,
      "end": 145.2,
      "startFrame": 4125,
      "endFrameExclusive": 4356,
      "sourceSegments": [
        79,
        81
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "完整保留本人总结与视线交流，前面已解释机制，此处无需再重复一镜。"
    },
    {
      "id": "B29",
      "scriptQuoteComparisonOnly": "机制顺了，不用你催，所有人都会主动把AI用起来。",
      "quote": "那么机制顺了不用你催所有人都会主动把AI用起来",
      "start": 145.2,
      "end": 151.54,
      "startFrame": 4356,
      "endFrameExclusive": 4546,
      "sourceSegments": [
        82,
        85
      ],
      "route": "speaker",
      "cueId": null,
      "reason": "所有人都会属于全称效果预测，单列未核验项；不能靠集体鼓掌或成功群像背书。"
    },
    {
      "id": "B30",
      "scriptQuoteComparisonOnly": "关注超哥，只讲AI落地的底层逻辑。",
