      "rhetoricalRole": "consulting-efficiency-claim",
      "claimClass": "factual-claim",
      "requiresFactCheck": true,
      "factCheckId": "F16",
      "primaryRoute": "speaker",
      "routeCueId": null,
      "decisionReason": "幅度未核验前保留真人并降低视觉断言强度，后期只在证据成立时加对照。",
      "viewerGain": "presenter-trust"
    },
    {
      "id": "B26",
      "order": 26,
      "scriptQuote": "以前从“客户有需求”到“顾问交付成果”之间，有一长串信息搬运和模式化分析的工作。这部分不产生策略价值，但必须有人做。",
      "rhetoricalRole": "information-chain",
      "claimClass": "abstract-explanation",
      "requiresFactCheck": false,
      "factCheckId": null,
      "primaryRoute": "paper-editorial",
      "routeCueId": "P06",
      "decisionReason": "长串中间工作是可见的流程关系，纸链压缩能直接解释。",
      "viewerGain": "explain-mechanism"
    },
    {
      "id": "B27",
      "order": 27,
      "scriptQuote": "AI接手了这一段，把顾问的精力释放到了真正需要人类判断的那部分。",
