  "beats": [
    {
      "beatId": "B01",
      "order": 1,
      "scriptQuote": "老板们别再因为其他企业用上了AI而焦虑",
      "primaryRoute": "speaker",
      "routeCueId": null,
      "spokenQuote": null,
      "startFrame": null,
      "endFrame": null
