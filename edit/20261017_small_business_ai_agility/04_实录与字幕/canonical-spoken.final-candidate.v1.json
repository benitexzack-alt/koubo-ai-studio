  "durationSeconds": 137.533333,
  "segments": [
    {
      "id": "S001",
      "start": 0.466,
      "end": 1.133,
      "text": "这两天呢"
    },
    {
      "id": "S002",
      "start": 1.133,
      "end": 2.933,
      "text": "有一个十来个人规模的"
    },
    {
      "id": "S003",
      "start": 2.933,
      "end": 4.8,
      "text": "公司老板找我来咨询"
    },
    {
      "id": "S004",
      "start": 4.9,
      "end": 7.2,
      "text": "问出了大多数老板的一个问题"
    },
    {
      "id": "S005",
      "start": 7.2,
      "end": 9.4,
      "text": "就是现在企业做AI变革"
    },
    {
      "id": "S006",
      "start": 9.666,
      "end": 11.866,
      "text": "我们这种小公司还来得及吗"
    },
    {
      "id": "S007",
      "start": 11.866,
      "end": 13.1,
      "text": "啊到底该怎么干"
    },
    {
      "id": "S008",
      "start": 13.4,
      "end": 15.766,
      "text": "其实呢恰恰是这种小规模的公司"
    },
    {
      "id": "S009",
      "start": 15.866,
      "end": 17.066,
      "text": "相比大企业"
    },
    {
      "id": "S010",
      "start": 17.066,
      "end": 18.8,
      "text": "优势反而会更大啊"
    },
    {
      "id": "S011",
      "start": 18.8,
      "end": 20.166,
      "text": "竞争力反倒更强"
    },
    {
      "id": "S012",
      "start": 20.3,
      "end": 21.8,
      "text": "核心原因就是小组织"
    },
    {
      "id": "S013",
      "start": 21.8,
      "end": 23.766,
      "text": "自带的组织灵敏性"
    },
    {
      "id": "S014",
      "start": 24.2,
      "end": 25.766,
      "text": "大企业层级多"
    },
    {
      "id": "S015",
      "start": 25.866,
      "end": 26.966,
      "text": "流程固化"
    },
    {
      "id": "S016",
      "start": 27.133,
      "end": 29.366,
      "text": "想要推一套AI改造的话"
    },
    {
      "id": "S017",
      "start": 29.366,
      "end": 30.533,
      "text": "就是层层汇报"
    },
    {
      "id": "S018",
      "start": 30.533,
      "end": 31.466,
      "text": "反复开会"
    },
    {
      "id": "S019",
      "start": 31.466,
      "end": 32.266,
      "text": "部门之间呢"
    },
    {
      "id": "S020",
      "start": 32.266,
      "end": 33.1,
      "text": "相互拉扯"
    },
    {
      "id": "S021",
      "start": 33.266,
      "end": 35.5,
      "text": "等真真的方案讨论落地的时候"
    },
    {
      "id": "S022",
      "start": 35.533,
      "end": 36.533,
      "text": "需要很久"
    },
    {
      "id": "S023",
      "start": 36.533,
      "end": 37.7,
      "text": "但是咱们这个十几个"
    },
    {
      "id": "S024",
      "start": 37.7,
      "end": 38.8,
      "text": "人的公司就不一样了"
    },
    {
      "id": "S025",
      "start": 38.8,
      "end": 40.366,
      "text": "老板一声拍板"
    },
    {
      "id": "S026",
      "start": 40.366,
      "end": 41.766,
      "text": "当天就能定方向"
    },
    {
      "id": "S027",
      "start": 42.1,
      "end": 43.2,
      "text": "不用复杂的审批"
    },
    {
      "id": "S028",
      "start": 43.3,
      "end": 45.6,
      "text": "不需要协调好几个部门"
    },
    {
      "id": "S029",
      "start": 45.666,
      "end": 46.966,
      "text": "试错成本极低"
    },
    {
      "id": "S030",
      "start": 47.266,
      "end": 48.9,
      "text": "我们不需要全员大改造"
    },
    {
      "id": "S031",
      "start": 48.9,
      "end": 50.866,
      "text": "啊也不需要全套的系统升级"
    },
    {
      "id": "S032",
      "start": 51.0,
      "end": 53.8,
      "text": "只针对销售运营行政客服"
    },
    {
      "id": "S033",
      "start": 53.8,
      "end": 55.866,
      "text": "剪辑文案这几个核心的岗位"
    },
    {
      "id": "S034",
      "start": 55.866,
      "end": 57.8,
      "text": "然后呢做精准的AI落地"
    },
    {
      "id": "S035",
      "start": 58.166,
      "end": 60.7,
      "text": "只要把这几个岗位的AI流程打通啊"
    },
    {
      "id": "S036",
      "start": 60.7,
      "end": 61.9,
      "text": "效率立刻翻倍"
    },
    {
      "id": "S037",
      "start": 62.166,
      "end": 63.566,
      "text": "成本呢也会立刻下降"
    },
    {
      "id": "S038",
      "start": 63.6,
      "end": 65.1,
      "text": "结果是立竿见影"
    },
    {
      "id": "S039",
      "start": 65.466,
      "end": 67.533,
      "text": "觉得这个AI工具好用"
    },
    {
      "id": "S040",
      "start": 67.533,
      "end": 70.766,
      "text": "那么全员呢当天就能用上用上手啊"
    },
    {
      "id": "S041",
      "start": 70.766,
      "end": 72.6,
      "text": "如果说哪个流程跑不通的时候呢"
    },
    {
      "id": "S042",
      "start": 72.6,
      "end": 73.533,
      "text": "我们马上就"
    },
    {
      "id": "S043",
      "start": 73.8,
      "end": 74.6,
      "text": "调整迭代"
    },
    {
      "id": "S044",
      "start": 74.7,
      "end": 76.666,
      "text": "这也是我现在在兰州最喜欢"
    },
    {
      "id": "S045",
      "start": 76.666,
      "end": 79.0,
      "text": "服务中小企业的核心原因"
    },
    {
      "id": "S046",
      "start": 79.066,
      "end": 79.8,
      "text": "大企业呢"
    },
    {
      "id": "S047",
      "start": 79.8,
      "end": 80.666,
      "text": "交付周期长"
    },
    {
      "id": "S048",
      "start": 80.666,
      "end": 81.9,
      "text": "然后落地阻力大"
    },
    {
      "id": "S049",
      "start": 81.9,
      "end": 82.933,
      "text": "内耗特别严重"
    },
    {
      "id": "S050",
      "start": 82.933,
      "end": 84.666,
      "text": "而咱们的本地的这个小微企业呢"
    },
    {
      "id": "S051",
      "start": 84.666,
      "end": 86.2,
      "text": "其实交付快落地快"
    },
    {
      "id": "S052",
      "start": 86.4,
      "end": 87.733,
      "text": "出效果更快"
    },
    {
      "id": "S053",
      "start": 87.9,
      "end": 89.133,
      "text": "AI真正的价值呢"
    },
    {
      "id": "S054",
      "start": 89.133,
      "end": 92.2,
      "text": "就是解决真实的业务问题"
    },
    {
      "id": "S055",
      "start": 92.266,
      "end": 94.4,
      "text": "然后呢帮企业提效"
    },
    {
      "id": "S056",
      "start": 94.4,
      "end": 95.533,
      "text": "帮老板省钱"
    },
    {
      "id": "S057",
      "start": 95.533,
      "end": 96.866,
      "text": "帮团队增收"
    },
    {
      "id": "S058",
      "start": 97.0,
      "end": 97.733,
      "text": "很多老板呢"
    },
    {
      "id": "S059",
      "start": 97.733,
      "end": 98.6,
      "text": "现在就很焦虑"
    },
    {
      "id": "S060",
      "start": 98.666,
      "end": 99.733,
      "text": "别人都在做AI"
    },
    {
      "id": "S061",
      "start": 99.733,
      "end": 101.266,
      "text": "我不做呢怕掉队"
    },
    {
      "id": "S062",
      "start": 101.6,
      "end": 103.966,
      "text": "做呢又不知道从哪里下手"
    },
    {
      "id": "S063",
      "start": 104.066,
      "end": 105.1,
      "text": "工具装了一堆"
    },
    {
      "id": "S064",
      "start": 105.1,
      "end": 106.333,
      "text": "啊最后全部闲置下来"
    },
    {
      "id": "S065",
      "start": 106.333,
      "end": 107.7,
      "text": "落不了地如果呢"
    },
    {
      "id": "S066",
      "start": 107.7,
      "end": 110.1,
      "text": "你也是在兰州本地的实体企业"
    },
    {
      "id": "S067",
      "start": 110.1,
      "end": 111.533,
      "text": "小微企业的老板啊"
    },
    {
      "id": "S068",
      "start": 111.533,
      "end": 113.733,
      "text": "你也遇到了AI不会落地"
    },
    {
      "id": "S069",
      "start": 113.733,
      "end": 114.666,
      "text": "用不出结果"
    },
    {
      "id": "S070",
      "start": 114.666,
      "end": 116.9,
      "text": "不知道怎么匹配自己业务"
    },
    {
      "id": "S071",
      "start": 117.133,
      "end": 118.8,
      "text": "或者是行业的一些问题"
    },
    {
      "id": "S072",
      "start": 119.0,
      "end": 120.4,
      "text": "评论区留下你的行业"
    },
    {
      "id": "S073",
      "start": 120.4,
      "end": 121.9,
      "text": "我来帮你免费拆解你"
    },
    {
      "id": "S074",
      "start": 121.9,
      "end": 124.066,
      "text": "的企业AI落地的方案"
    },
    {
      "id": "S075",
      "start": 124.266,
      "end": 125.9,
      "text": "想面对面聊啊"
    },
    {
      "id": "S076",
      "start": 125.9,
      "end": 128.933,
      "text": "想要做本地的一对一的AI改造"
    },
    {
      "id": "S077",
      "start": 129.2,
      "end": 130.766,
      "text": "也可以直接进我的粉丝群"
    },
    {
      "id": "S078",
      "start": 130.766,
      "end": 131.7,
      "text": "我是超哥"
    },
    {
      "id": "S079",
      "start": 131.733,
      "end": 132.6,
      "text": "扎根兰州"
    },
    {
      "id": "S080",
      "start": 132.766,
      "end": 135.066,
      "text": "只做能落地有结果帮"
    },
    {
      "id": "S081",
      "start": 135.066,
      "end": 137.533,
      "text": "企业赚钱的AI实体应用"
    }
  ],
