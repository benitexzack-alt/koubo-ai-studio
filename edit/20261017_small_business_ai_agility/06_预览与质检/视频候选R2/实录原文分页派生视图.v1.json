  },
  "segments": [
    {
      "id": "S001",
      "start": 0.466,
      "end": 1.133,
      "text": "这两天呢",
      "originalSourceSegmentIds": [
        "S001"
      ]
    },
    {
      "id": "S002",
      "start": 1.133,
      "end": 2.933,
      "text": "有一个十来个人规模的",
      "originalSourceSegmentIds": [
        "S002"
      ]
    },
    {
      "id": "S003",
      "start": 2.933,
      "end": 4.8,
      "text": "公司老板找我来咨询",
      "originalSourceSegmentIds": [
        "S003"
      ]
    },
    {
      "id": "S004",
      "start": 4.9,
      "end": 7.2,
      "text": "问出了大多数老板的一个问题",
      "originalSourceSegmentIds": [
        "S004"
      ]
    },
    {
      "id": "S005",
      "start": 7.2,
      "end": 9.4,
      "text": "就是现在企业做AI变革",
      "originalSourceSegmentIds": [
        "S005"
      ]
    },
    {
      "id": "S006",
      "start": 9.666,
      "end": 11.866,
      "text": "我们这种小公司还来得及吗",
      "originalSourceSegmentIds": [
        "S006"
      ]
    },
    {
      "id": "S007",
      "start": 11.866,
      "end": 13.1,
      "text": "啊到底该怎么干",
      "originalSourceSegmentIds": [
        "S007"
      ]
    },
    {
      "id": "S008",
      "start": 13.4,
      "end": 15.766,
      "text": "其实呢恰恰是这种小规模的公司",
      "originalSourceSegmentIds": [
        "S008"
      ]
    },
    {
      "id": "S009",
      "start": 15.866,
      "end": 17.066,
      "text": "相比大企业",
      "originalSourceSegmentIds": [
        "S009"
      ]
    },
    {
      "id": "S010",
      "start": 17.066,
      "end": 18.8,
      "text": "优势反而会更大啊",
      "originalSourceSegmentIds": [
        "S010"
      ]
    },
    {
      "id": "S011",
      "start": 18.8,
      "end": 20.166,
      "text": "竞争力反倒更强",
      "originalSourceSegmentIds": [
        "S011"
      ]
    },
    {
      "id": "S012",
      "start": 20.3,
      "end": 21.8,
      "text": "核心原因就是小组织",
      "originalSourceSegmentIds": [
        "S012"
      ]
    },
    {
      "id": "S013",
      "start": 21.8,
      "end": 23.766,
      "text": "自带的组织灵敏性",
      "originalSourceSegmentIds": [
        "S013"
      ]
    },
    {
      "id": "S014",
      "start": 24.2,
      "end": 25.766,
      "text": "大企业层级多",
      "originalSourceSegmentIds": [
        "S014"
      ]
    },
    {
      "id": "S015",
      "start": 25.866,
      "end": 26.966,
      "text": "流程固化",
      "originalSourceSegmentIds": [
        "S015"
      ]
    },
    {
      "id": "S016",
      "start": 27.133,
      "end": 29.366,
      "text": "想要推一套AI改造的话",
      "originalSourceSegmentIds": [
        "S016"
      ]
    },
    {
      "id": "S017",
      "start": 29.366,
      "end": 30.533,
      "text": "就是层层汇报",
      "originalSourceSegmentIds": [
        "S017"
      ]
    },
    {
      "id": "S018",
      "start": 30.533,
      "end": 31.466,
      "text": "反复开会",
      "originalSourceSegmentIds": [
        "S018"
      ]
    },
    {
      "id": "S019",
      "start": 31.466,
      "end": 32.266,
      "text": "部门之间呢",
      "originalSourceSegmentIds": [
        "S019"
      ]
    },
    {
      "id": "S020",
      "start": 32.266,
      "end": 33.1,
      "text": "相互拉扯",
      "originalSourceSegmentIds": [
        "S020"
      ]
    },
    {
      "id": "S021",
      "start": 33.266,
      "end": 35.5,
      "text": "等真真的方案讨论落地的时候",
      "originalSourceSegmentIds": [
        "S021"
      ]
    },
    {
      "id": "S022",
      "start": 35.533,
      "end": 36.533,
      "text": "需要很久",
      "originalSourceSegmentIds": [
        "S022"
      ]
    },
    {
      "id": "S023_S024",
      "start": 36.533,
      "end": 38.8,
      "text": "但是咱们这个十几个人的公司就不一样了",
      "originalSourceSegmentIds": [
        "S023",
        "S024"
      ]
    },
    {
      "id": "S025",
      "start": 38.8,
      "end": 40.366,
      "text": "老板一声拍板",
      "originalSourceSegmentIds": [
        "S025"
      ]
    },
    {
      "id": "S026",
      "start": 40.366,
      "end": 41.766,
      "text": "当天就能定方向",
      "originalSourceSegmentIds": [
        "S026"
      ]
    },
    {
      "id": "S027",
      "start": 42.1,
      "end": 43.2,
      "text": "不用复杂的审批",
      "originalSourceSegmentIds": [
        "S027"
      ]
    },
    {
      "id": "S028",
      "start": 43.3,
      "end": 45.6,
      "text": "不需要协调好几个部门",
      "originalSourceSegmentIds": [
        "S028"
      ]
    },
    {
      "id": "S029",
      "start": 45.666,
      "end": 46.966,
      "text": "试错成本极低",
      "originalSourceSegmentIds": [
        "S029"
      ]
    },
    {
      "id": "S030",
      "start": 47.266,
      "end": 48.9,
      "text": "我们不需要全员大改造",
      "originalSourceSegmentIds": [
        "S030"
      ]
    },
    {
      "id": "S031",
      "start": 48.9,
      "end": 50.866,
      "text": "啊也不需要全套的系统升级",
      "originalSourceSegmentIds": [
        "S031"
      ]
    },
    {
      "id": "S032",
      "start": 51,
      "end": 53.8,
      "text": "只针对销售运营行政客服",
      "originalSourceSegmentIds": [
        "S032"
      ]
    },
    {
      "id": "S033",
      "start": 53.8,
      "end": 55.866,
      "text": "剪辑文案这几个核心的岗位",
      "originalSourceSegmentIds": [
        "S033"
      ]
    },
    {
      "id": "S034",
      "start": 55.866,
      "end": 57.8,
      "text": "然后呢做精准的AI落地",
      "originalSourceSegmentIds": [
        "S034"
      ]
    },
    {
      "id": "S035",
      "start": 58.166,
      "end": 60.7,
      "text": "只要把这几个岗位的AI流程打通啊",
      "originalSourceSegmentIds": [
        "S035"
      ]
    },
    {
      "id": "S036",
      "start": 60.7,
      "end": 61.9,
      "text": "效率立刻翻倍",
      "originalSourceSegmentIds": [
        "S036"
      ]
    },
    {
      "id": "S037",
      "start": 62.166,
      "end": 63.566,
      "text": "成本呢也会立刻下降",
      "originalSourceSegmentIds": [
        "S037"
      ]
    },
    {
      "id": "S038",
      "start": 63.6,
      "end": 65.1,
      "text": "结果是立竿见影",
      "originalSourceSegmentIds": [
        "S038"
      ]
    },
    {
      "id": "S039",
      "start": 65.466,
      "end": 67.533,
      "text": "觉得这个AI工具好用",
      "originalSourceSegmentIds": [
        "S039"
      ]
    },
    {
      "id": "S040",
      "start": 67.533,
      "end": 70.766,
      "text": "那么全员呢当天就能用上用上手啊",
      "originalSourceSegmentIds": [
        "S040"
      ]
    },
    {
      "id": "S041",
      "start": 70.766,
      "end": 72.6,
      "text": "如果说哪个流程跑不通的时候呢",
      "originalSourceSegmentIds": [
        "S041"
      ]
    },
    {
      "id": "S042",
      "start": 72.6,
      "end": 73.533,
      "text": "我们马上就",
      "originalSourceSegmentIds": [
        "S042"
      ]
    },
    {
      "id": "S043",
      "start": 73.8,
      "end": 74.6,
      "text": "调整迭代",
      "originalSourceSegmentIds": [
        "S043"
      ]
    },
    {
      "id": "S044",
      "start": 74.7,
      "end": 76.666,
      "text": "这也是我现在在兰州最喜欢",
      "originalSourceSegmentIds": [
        "S044"
      ]
    },
    {
      "id": "S045",
      "start": 76.666,
      "end": 79,
      "text": "服务中小企业的核心原因",
      "originalSourceSegmentIds": [
        "S045"
      ]
    },
    {
      "id": "S046",
      "start": 79.066,
      "end": 79.8,
      "text": "大企业呢",
      "originalSourceSegmentIds": [
        "S046"
      ]
    },
    {
      "id": "S047",
      "start": 79.8,
      "end": 80.666,
      "text": "交付周期长",
      "originalSourceSegmentIds": [
        "S047"
      ]
    },
    {
      "id": "S048",
      "start": 80.666,
      "end": 81.9,
      "text": "然后落地阻力大",
      "originalSourceSegmentIds": [
        "S048"
      ]
    },
    {
      "id": "S049",
      "start": 81.9,
      "end": 82.933,
      "text": "内耗特别严重",
      "originalSourceSegmentIds": [
        "S049"
      ]
    },
    {
      "id": "S050",
      "start": 82.933,
      "end": 84.666,
      "text": "而咱们的本地的这个小微企业呢",
      "originalSourceSegmentIds": [
        "S050"
      ]
    },
    {
      "id": "S051",
      "start": 84.666,
      "end": 86.2,
      "text": "其实交付快落地快",
      "originalSourceSegmentIds": [
        "S051"
      ]
    },
    {
      "id": "S052",
      "start": 86.4,
      "end": 87.733,
      "text": "出效果更快",
      "originalSourceSegmentIds": [
        "S052"
      ]
    },
    {
      "id": "S053",
      "start": 87.9,
      "end": 89.133,
      "text": "AI真正的价值呢",
      "originalSourceSegmentIds": [
        "S053"
      ]
    },
    {
      "id": "S054",
      "start": 89.133,
      "end": 92.2,
      "text": "就是解决真实的业务问题",
      "originalSourceSegmentIds": [
        "S054"
      ]
    },
    {
      "id": "S055",
      "start": 92.266,
      "end": 94.4,
      "text": "然后呢帮企业提效",
      "originalSourceSegmentIds": [
        "S055"
      ]
    },
    {
      "id": "S056",
      "start": 94.4,
      "end": 95.533,
      "text": "帮老板省钱",
      "originalSourceSegmentIds": [
        "S056"
      ]
    },
    {
      "id": "S057",
      "start": 95.533,
      "end": 96.866,
      "text": "帮团队增收",
      "originalSourceSegmentIds": [
        "S057"
      ]
    },
    {
      "id": "S058",
      "start": 97,
      "end": 97.733,
      "text": "很多老板呢",
      "originalSourceSegmentIds": [
        "S058"
      ]
    },
    {
      "id": "S059",
      "start": 97.733,
      "end": 98.6,
      "text": "现在就很焦虑",
      "originalSourceSegmentIds": [
        "S059"
      ]
    },
    {
      "id": "S060",
      "start": 98.666,
      "end": 99.733,
      "text": "别人都在做AI",
      "originalSourceSegmentIds": [
        "S060"
      ]
    },
    {
      "id": "S061",
      "start": 99.733,
      "end": 101.266,
      "text": "我不做呢怕掉队",
      "originalSourceSegmentIds": [
        "S061"
      ]
    },
    {
      "id": "S062",
      "start": 101.6,
      "end": 103.966,
      "text": "做呢又不知道从哪里下手",
      "originalSourceSegmentIds": [
        "S062"
      ]
    },
    {
      "id": "S063",
      "start": 104.066,
      "end": 105.1,
      "text": "工具装了一堆",
      "originalSourceSegmentIds": [
        "S063"
      ]
    },
    {
      "id": "S064",
      "start": 105.1,
      "end": 106.333,
      "text": "啊最后全部闲置下来",
      "originalSourceSegmentIds": [
        "S064"
      ]
    },
    {
      "id": "S065",
      "start": 106.333,
      "end": 107.7,
      "text": "落不了地如果呢",
      "originalSourceSegmentIds": [
        "S065"
      ]
    },
    {
      "id": "S066",
      "start": 107.7,
      "end": 110.1,
      "text": "你也是在兰州本地的实体企业",
      "originalSourceSegmentIds": [
        "S066"
      ]
    },
    {
      "id": "S067",
      "start": 110.1,
      "end": 111.533,
      "text": "小微企业的老板啊",
      "originalSourceSegmentIds": [
        "S067"
      ]
    },
    {
      "id": "S068",
      "start": 111.533,
      "end": 113.733,
      "text": "你也遇到了AI不会落地",
      "originalSourceSegmentIds": [
        "S068"
      ]
    },
    {
      "id": "S069",
      "start": 113.733,
      "end": 114.666,
      "text": "用不出结果",
      "originalSourceSegmentIds": [
        "S069"
      ]
    },
    {
      "id": "S070",
      "start": 114.666,
      "end": 116.9,
      "text": "不知道怎么匹配自己业务",
      "originalSourceSegmentIds": [
        "S070"
      ]
    },
    {
      "id": "S071",
      "start": 117.133,
      "end": 118.8,
      "text": "或者是行业的一些问题",
      "originalSourceSegmentIds": [
        "S071"
      ]
    },
    {
      "id": "S072",
      "start": 119,
      "end": 120.4,
      "text": "评论区留下你的行业",
      "originalSourceSegmentIds": [
        "S072"
      ]
    },
    {
      "id": "S073_S074",
      "start": 120.4,
      "end": 124.066,
      "text": "我来帮你免费拆解你的企业AI落地的方案",
      "originalSourceSegmentIds": [
        "S073",
        "S074"
      ]
    },
    {
      "id": "S075",
      "start": 124.266,
      "end": 125.9,
      "text": "想面对面聊啊",
      "originalSourceSegmentIds": [
        "S075"
      ]
    },
    {
      "id": "S076",
      "start": 125.9,
      "end": 128.933,
      "text": "想要做本地的一对一的AI改造",
      "originalSourceSegmentIds": [
        "S076"
      ]
    },
    {
      "id": "S077",
      "start": 129.2,
      "end": 130.766,
      "text": "也可以直接进我的粉丝群",
      "originalSourceSegmentIds": [
        "S077"
      ]
    },
    {
      "id": "S078",
      "start": 130.766,
      "end": 131.7,
      "text": "我是超哥",
      "originalSourceSegmentIds": [
        "S078"
      ]
    },
    {
      "id": "S079",
      "start": 131.733,
      "end": 132.6,
      "text": "扎根兰州",
      "originalSourceSegmentIds": [
        "S079"
      ]
    },
    {
      "id": "S080_S081",
      "start": 132.766,
      "end": 137.533,
      "text": "只做能落地有结果帮企业赚钱的AI实体应用",
      "originalSourceSegmentIds": [
        "S080",
        "S081"
      ]
    }
  ],
