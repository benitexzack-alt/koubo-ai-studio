    "cues": [
      {"id": "cleaned-page-001", "start": 0, "end": 2.48, "text": "那么再往下，我问它："},
      {"id": "cleaned-page-002", "start": 2.48, "end": 5.52, "text": "我现在在兰州中心附近，四个人，"},
      {"id": "cleaned-page-003", "start": 5.52, "end": 8.09, "text": "不吃辣，想吃清淡一点，"},
      {"id": "cleaned-page-004", "start": 8.09, "end": 10.64, "text": "最好就是减肥期也能吃。"},
      {"id": "cleaned-page-005", "start": 10.64, "end": 13.31, "text": "以前碰到这种问题，我们"},
      {"id": "cleaned-page-006", "start": 13.31, "end": 15.99, "text": "四个人可能就要开始分工了。"},
      {"id": "cleaned-page-007", "start": 15.99, "end": 18.7, "text": "一个刷短视频，一个翻评论，"},
      {"id": "cleaned-page-008", "start": 18.7, "end": 22.23, "text": "一个打开地图，还有一个问朋友。"},
      {"id": "cleaned-page-009", "start": 22.23, "end": 25.64, "text": "这次它先给到了几个方向，"},
      {"id": "cleaned-page-010", "start": 25.64, "end": 29.36, "text": "然后直接把位置落到了地图上。"},
      {"id": "cleaned-page-011", "start": 29.36, "end": 31.84, "text": "点进一家店，后面接着"},
      {"id": "cleaned-page-012", "start": 31.84, "end": 36.64, "text": "就是门店的小程序、菜单和点餐页面。"},
      {"id": "cleaned-page-013", "start": 36.64, "end": 39.71, "text": "老板们，到这儿看明白了没有？"},
      {"id": "cleaned-page-014", "start": 39.71, "end": 42.84, "text": "这里最值得我们研究的，"},
      {"id": "cleaned-page-015-partial", "start": 42.84, "end": 45, "text": "不是它推荐了哪家店，"}
    ]
