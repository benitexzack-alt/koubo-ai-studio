        "sourceCaptions": [
          {
            "en": "You can help collect those answers.",
            "id": "cap-b07-p01",
            "zh": "你可以帮他把这些回答收集起来"
          },
          {
            "en": "Use AI to categorize and organize them.",
            "id": "cap-b07-p02",
            "zh": "用AI归类理顺"
          },
          {
            "en": "Then turn them into video-ready scripts for the owner to verify.",
            "id": "cap-b07-p03",
            "zh": "然后改成适合拍视频的文稿再由老板核对"
          },
          {
            "en": "Add product and service materials that can be made public, and explain them one by one.",
            "id": "cap-b07-p04",
            "zh": "配上能公开的产品和服务资料一条条的讲出去"
          },
          {
            "en": "AI handles part of the organizing and production.",
            "id": "cap-b07-p05",
            "zh": "AI承担整理和制作的部分工作"
          },
          {
            "en": "But the foundation is still the business the owner has actually done.",
            "id": "cap-b07-p06",
            "zh": "内容的底子还是老板自己做过的生意"
          }
        ],
