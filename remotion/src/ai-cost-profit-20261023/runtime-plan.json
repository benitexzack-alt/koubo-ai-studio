      "to": 7019,
      "chinese": "最后呢",
      "english": "In the end,"
    },
    {
      "id": 120,
      "from": 7019,
      "to": 7107,
      "chinese": "受影响的还是所有做生意的人啊",
      "english": "everyone doing business feels the impact,"
    },
    {
      "id": 121,
      "from": 7123,
      "to": 7168,
      "chinese": "包括你这里面呢",
      "english": "including you. Here,"
    },
    {
      "id": 122,
      "from": 7183,
      "to": 7205,
      "chinese": "有三个速度",
      "english": "there are three speeds."
    },
    {
      "id": 123,
      "from": 7218,
      "to": 7261,
      "chinese": "技术铺开很快",
      "english": "Technology spreads quickly."
    },
    {
      "id": 124,
      "from": 7261,
      "to": 7308,
      "chinese": "同行呢跟进也很快",
      "english": "Competitors catch up quickly too."
    },
    {
      "id": 125,
      "from": 7308,
      "to": 7379,
      "chinese": "但是一个人换行业",
      "english": "But for a person to change industries,"
    },
    {
      "id": 126,
      "from": 7379,
      "to": 7405,
      "chinese": "学新的技能",
      "english": "learn new skills,"
    },
    {
      "id": 127,
      "from": 7405,
      "to": 7467,
      "chinese": "找到新的收入他很慢",
      "english": "and find a new income—that takes time."
    },
    {
      "id": 128,
      "from": 7481,
      "to": 7556,
      "chinese": "真正难熬的就是这三个",
      "english": "What's really hard is the period when these three"
    },
    {
      "id": 129,
      "from": 7556,
      "to": 7631,
      "chinese": "速度对不上的那段时间",
      "english": "speeds don't line up."
    },
    {
      "id": 130,
      "from": 7649,
      "to": 7700,
      "chinese": "至于老干妈的那500个人啊",
      "english": "As for those 500 people at Lao Gan Ma,"
    },
    {
      "id": 131,
      "from": 7700,
      "to": 7784,
      "chinese": "去哪了目前没有公开报道啊",
      "english": "there are currently no public reports on where they went."
    },
    {
      "id": 132,
      "from": 7784,
      "to": 7818,
      "chinese": "我们也不乱猜",
      "english": "We won't speculate either."
    },
    {
      "id": 133,
      "from": 7818,
      "to": 7852,
      "chinese": "但是AI呢",
      "english": "But AI—"
    },
    {
      "id": 134,
      "from": 7852,
      "to": 7902,
      "chinese": "那到底还用不用",
      "english": "should we still use it or not?"
    },
    {
      "id": 135,
      "from": 7918,
      "to": 7969,
      "chinese": "我说还得用",
      "english": "I say we still have to,"
    },
    {
      "id": 136,
      "from": 7969,
      "to": 8036,
      "chinese": "而且得马上用",
      "english": "and we need to start right away."
    },
    {
      "id": 137,
      "from": 8055,
      "to": 8142,
      "chinese": "不用可能连现在的单",
      "english": "Without it, even the orders you have now"
    },
    {
      "id": 138,
      "from": 8142,
      "to": 8179,
      "chinese": "都保不住了",
      "english": "might be lost."
    },
    {
      "id": 139,
      "from": 8179,
      "to": 8275,
      "chinese": "但用之前还是要想清楚三件事情",
      "english": "But before using it, think through three things."
    },
    {
      "id": 140,
      "from": 8291,
      "to": 8369,
      "chinese": "第一就是别把AI当利润啊",
      "english": "First, don't treat AI as profit."
    },
    {
      "id": 141,
      "from": 8369,
      "to": 8404,
      "chinese": "它只是门票",
      "english": "It's only an admission ticket."
    },
    {
      "id": 142,
      "from": 8404,
      "to": 8468,
      "chinese": "就是它让你能够留在牌桌上",
      "english": "It lets you stay at the table."
    },
    {
      "id": 143,
      "from": 8468,
      "to": 8502,
      "chinese": "不保证你赢",
      "english": "It doesn't guarantee you'll win."
    },
    {
      "id": 144,
      "from": 8502,
      "to": 8528,
      "chinese": "那么第二呢",
      "english": "Second,"
    },
    {
      "id": 145,
      "from": 8528,
      "to": 8588,
      "chinese": "就是省下来的钱要",
      "english": "the money you save needs to"
    },
    {
      "id": 146,
      "from": 8588,
      "to": 8642,
      "chinese": "变成别人抄不走的东西",
      "english": "become something others can't copy."
    },
    {
      "id": 147,
      "from": 8642,
      "to": 8711,
      "chinese": "啊老干妈能把效率留住",
      "english": "Lao Gan Ma can retain its efficiency gains"
    },
    {
      "id": 148,
      "from": 8711,
      "to": 8776,
      "chinese": "靠的不是那台质检相机",
      "english": "not because of that inspection camera,"
    },
    {
      "id": 149,
      "from": 8776,
      "to": 8828,
      "chinese": "是它的品牌",
      "english": "but because of its brand,"
    },
    {
      "id": 150,
      "from": 8828,
      "to": 8909,
      "chinese": "啊渠道和那口味道",
      "english": "its channels, and that flavor."
    },
    {
      "id": 151,
      "from": 8927,
      "to": 9008,
      "chinese": "你的护城河是你的客户关系",
      "english": "Your moat is your customer relationships,"
    },
    {
      "id": 152,
      "from": 9008,
      "to": 9101,
      "chinese": "你手里的行业数据和你的服务口碑",
      "english": "the industry data you hold, and your reputation for service."
    },
    {
      "id": 153,
      "from": 9101,
      "to": 9194,
      "chinese": "第三省下来的人别只想着砍掉",
      "english": "Third, don't just think of cutting the people you no longer need."
    },
    {
      "id": 154,
      "from": 9194,
      "to": 9271,
      "chinese": "让懂业务的这些老员工去管AI",
      "english": "Let experienced employees who know the business manage AI,"
    },
    {
      "id": 155,
      "from": 9271,
      "to": 9319,
      "chinese": "去服务客户",
      "english": "serve customers,"
    },
    {
      "id": 156,
      "from": 9319,
      "to": 9344,
      "chinese": "去盯质量",
      "english": "and watch quality."
    },
    {
      "id": 157,
      "from": 9344,
      "to": 9433,
      "chinese": "那么这些人才是同行最难复制的",
      "english": "These are the people your competitors find hardest to replicate."
    },
    {
      "id": 158,
      "from": 9433,
      "to": 9527,
      "chinese": "AI呢一定会让东西变便宜",
      "english": "AI will definitely make things cheaper."
    },
    {
      "id": 159,
      "from": 9527,
      "to": 9568,
      "chinese": "但便宜下来的钱",
      "english": "But the money saved as prices fall"
    },
    {
      "id": 160,
      "from": 9568,
      "to": 9614,
      "chinese": "不一定落在你的手里",
      "english": "won't necessarily end up in your hands."
    },
    {
      "id": 161,
      "from": 9614,
      "to": 9661,
      "chinese": "能留在你手里的",
      "english": "What you can keep"
    },
    {
      "id": 162,
      "from": 9661,
      "to": 9755,
      "chinese": "是那些AI也替代不了的东西",
      "english": "comes from the things even AI cannot replace."
    },
    {
      "id": 163,
      "from": 9755,
      "to": 9786,
      "chinese": "我是超哥",
      "english": "I'm Chao."
    },
    {
      "id": 164,
      "from": 9786,
      "to": 9855,
      "chinese": "专注企业AI落地",
      "english": "I focus on putting AI to work in businesses."
    }
