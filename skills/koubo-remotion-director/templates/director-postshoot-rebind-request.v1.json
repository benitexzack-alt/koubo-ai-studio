{
  "schemaVersion": "koubo-director-postshoot-rebind-request/v1",
  "requestId": "<NEW_POSTSHOOT_REQUEST_ID>",
  "revisionId": "<NEW_POSTSHOOT_REVISION_ID>",
  "taskId": "<TASK_ID>",
  "policy": {
    "incidentPreventionVersion": "1"
  },
  "phase": "post-shoot",
  "timelineFps": 30,
  "sourcePreproduction": {
    "requestPath": "<PREPRODUCTION_REQUEST_PATH>",
    "requestSha256": "<SHA256>",
    "planPath": "<PREPRODUCTION_PLAN_PATH>",
    "planSha256": "<SHA256>",
    "validationReceiptPath": "<PREPRODUCTION_VALIDATION_RECEIPT_PATH>",
    "validationReceiptSha256": "<SHA256>"
  },
  "recordedMedia": {
    "path": "<RECORDED_MEDIA_PATH>",
    "sha256": "<SHA256>",
    "durationSeconds": 0
  },
  "spokenTimeline": {
    "path": "<AUTHORITATIVE_SPOKEN_TIMELINE_PATH>",
    "sha256": "<SHA256>",
    "authority": "recorded-audio",
    "scriptRole": "comparison-only"
  },
  "mappings": [
    {
      "beatId": "<BEAT_ID>",
      "order": 1,
      "disposition": "keep",
      "semanticTimingMode": "contextual-summary-after-spoken-terms",
      "startSeconds": 0,
      "endSeconds": 0,
      "actualCaptionIds": ["<CAPTION_ID>"],
      "anchorStartMs": 0,
      "anchorEndMs": 0,
      "actualSpokenLine": "<ACTUAL_RECORDED_WORDING>",
      "semanticAnchorText": "<EXACT_TEXT_INSIDE_DECLARED_CAPTION_WINDOW>",
      "alignmentStatus": "exact",
      "nodeTextBindings": [
        {
          "nodeId": "<NODE_ID>",
          "resolvedText": "<2_TO_8_CHINESE_CHARACTERS>",
          "enterStageId": "initial",
          "actualCaptionIds": ["<CAPTION_ID>"],
          "actualSpokenTerms": ["<EXACT_RECORDED_TERM>"],
          "anchorStartMs": 0,
          "anchorEndMs": 0,
          "visualEnterMs": 0,
          "firstReadableFrame": 0,
          "stageActionFrame": null,
          "labelEnterFrame": 0,
          "emphasisStageId": null,
          "emphasisFrame": null,
          "alignmentStatus": "exact"
        }
      ],
      "textDecision": "confirmed",
      "visualDecision": "keep"
    },
    {
      "beatId": "<NOT_SPOKEN_PREPRODUCTION_BEAT_ID>",
      "order": 2,
      "disposition": "omit",
      "reason": "not-spoken",
      "omissionEvidence": {
        "path": "<FULL_RECORDING_OMISSION_REVIEW_JSON_PATH>",
        "sha256": "<SHA256>"
      }
    }
  ],
  "outputs": {
    "rebindPlanPath": "<NEW_REBIND_PLAN_PATH>",
    "validationReceiptPath": "<NEW_POSTSHOOT_VALIDATION_RECEIPT_PATH>"
  }
}
