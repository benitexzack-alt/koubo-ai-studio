{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "插入镜头生成方案",
  "description": "兼容旧 episode 字符串的纸艺/像素方案；新 episode 对象启用测绘图纸和主辅风格协议。结构通过不代表来源真实性、引文逐字准确、语义、实录逐词或视觉避让通过。安全路径、时间顺序、不重叠、30fps 整数帧、镜号唯一、enterSec 小于 duration、主辅风格互异、镜头属于主辅风格及主风格至少 70%、ledger3 的三个 facet 与一个 result 及因子标签字数差由配套校验器检查。",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode", "canvas", "shots"],
  "properties": {
    "episode": {"oneOf": [{"$ref": "#/$defs/pathComponent"}, {"$ref": "#/$defs/episode"}]},
    "canvas": {"type": "object", "additionalProperties": false, "required": ["width", "height", "fps"], "properties": {"width": {"const": 1920}, "height": {"const": 1080}, "fps": {"const": 30}}},
    "shots": {"type": "array", "description": "按 insertAt 顺序排列；本期不需要插入镜头时可以为空。"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "pathComponent": {"type": "string", "minLength": 1, "pattern": "^(?!\\.{1,2}$)(?!.*[. ]$)[^/\\\\\\u0000-\\u001f\\u007f<>:\"|?*]+$", "description": "安全的单个目录名或文件名主体；前后空白、系统保留名称另由配套校验器拒绝。"},
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "object", "enterSec"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 6, "pattern": "\\p{Script=Han}", "description": "原样贴入画面的中文标签，最多 6 个 Unicode 字符。"},
        "object": {"$ref": "#/$defs/text", "description": "一句话描述看得见的物件及动作。"},
        "enterSec": {"type": "number", "minimum": 0, "description": "相对于本镜头起点，严格小于 duration；标签不得提前出现，按 ceil(enterSec*30-1e-6) 取出现帧，该帧必须小于 duration*30，保证至少一帧可见。导演按实录中说到此词的时点填写。节点列表是空间顺序，不要求出现时间递增。"}
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shotId", "insertAt", "duration", "style", "theme", "title", "spokenLine", "nodes", "flow", "ending", "avoid"],
      "properties": {
        "shotId": {"$ref": "#/$defs/pathComponent"},
        "insertAt": {"type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"},
        "duration": {"type": "number", "exclusiveMinimum": 0, "description": "剪入长度，以秒表示；乘以 30 必须是正整数帧，允许浮点计算精度误差。"},
        "style": {"enum": ["paper", "pixel"]},
        "theme": {"$ref": "#/$defs/text", "description": "paper 填一句主色调描述；pixel 只能为 noir、blocks 或 mono。"},
        "title": {"$ref": "#/$defs/text"},
        "spokenLine": {"$ref": "#/$defs/text"},
        "nodes": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/node"}},
        "flow": {"$ref": "#/$defs/text"},
        "ending": {"$ref": "#/$defs/text"},
        "avoid": {"type": "array", "items": {"$ref": "#/$defs/text"}}
      },
      "allOf": [{"if": {"properties": {"style": {"const": "pixel"}}}, "then": {"properties": {"theme": {"enum": ["noir", "blocks", "mono"]}}}}]
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "primaryStyle"],
      "properties": {"id": {"$ref": "#/$defs/pathComponent"}, "primaryStyle": {"enum": ["paper", "pixel", "drafting"]}, "secondaryStyle": {"enum": ["paper", "pixel", "drafting"], "description": "可省略，不能等于 primaryStyle。"}}
    },
    "extendedNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "object", "enterSec"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 6, "pattern": "\\p{Script=Han}", "description": "原样贴入画面的中文标签，最多 6 个 Unicode 字符。"},
        "object": {"$ref": "#/$defs/text", "description": "一句话描述看得见的物件及动作。"},
        "enterSec": {"type": "number", "minimum": 0, "description": "相对于本镜头起点，严格小于 duration；标签不得提前出现，按 ceil(enterSec*30-1e-6) 取出现帧，该帧必须小于 duration*30，保证至少一帧可见。导演按实录中说到此词的时点填写。节点列表是空间顺序，不要求出现时间递增。"},
        "kind": {"enum": ["claim", "facet", "result", "quote", "readout"]},
        "value": {"$ref": "#/$defs/text", "description": "可选上屏文字；包含阿拉伯或中文数量字符时必须提供 source。"},
        "source": {"$ref": "#/$defs/text", "description": "出处说明或“假设：…”；字段存在不代表来源真实或已核验。"}
      },
      "allOf": [{"if": {"required": ["value"], "properties": {"value": {"type": "string", "pattern": "[\\p{Number}零〇一二三四五六七八九十百千万亿两壹贰叁肆伍陆柒捌玖拾佰仟萬億兆半廿卅]"}}}, "then": {"required": ["source"]}}]
    },
    "extendedShot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shotId", "insertAt", "duration", "style", "theme", "title", "spokenLine", "nodes", "flow", "ending", "avoid"],
      "properties": {
        "shotId": {"$ref": "#/$defs/pathComponent"},
        "insertAt": {"type": "string", "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}$"},
        "duration": {"type": "number", "exclusiveMinimum": 0, "description": "剪入长度，以秒表示；乘以 30 必须是正整数帧，允许浮点计算精度误差。"},
        "style": {"enum": ["paper", "pixel", "drafting"]},
        "theme": {"$ref": "#/$defs/text", "description": "paper 或 drafting 填一句非空主色调描述；pixel 只能为 noir、blocks 或 mono。"},
        "title": {"$ref": "#/$defs/text"},
        "spokenLine": {"$ref": "#/$defs/text"},
        "nodes": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/extendedNode"}},
        "flow": {"$ref": "#/$defs/text"},
        "ending": {"$ref": "#/$defs/text"},
        "avoid": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "layout": {"enum": ["ledger3", "compare2", "flow", "clause", "readout", "stack"]},
        "assumption": {"type": "boolean", "description": "drafting 必填；true 时展示假设标记，数字 source 以“假设：”开头。"}
      },
      "allOf": [
        {"if": {"properties": {"style": {"const": "pixel"}}}, "then": {"properties": {"theme": {"enum": ["noir", "blocks", "mono"]}}}},
        {"if": {"properties": {"style": {"const": "drafting"}}}, "then": {"required": ["layout", "assumption"], "properties": {"nodes": {"items": {"required": ["kind"]}}}}},
        {"if": {"required": ["layout"], "properties": {"layout": {"const": "stack"}}}, "then": {"properties": {"nodes": {"maxItems": 4}}}},
        {
          "if": {"required": ["layout"], "properties": {"layout": {"const": "clause"}}},
          "then": {
            "properties": {
              "nodes": {
                "contains": {"required": ["kind"], "properties": {"kind": {"const": "quote"}}},
                "items": {"if": {"required": ["kind"], "properties": {"kind": {"const": "quote"}}}, "then": {"required": ["value", "source"]}}
              }
            }
          }
        },
        {
          "if": {"required": ["assumption"], "properties": {"assumption": {"const": true}}},
          "then": {
            "properties": {
              "nodes": {
                "items": {
                  "if": {"required": ["value"], "properties": {"value": {"type": "string", "pattern": "[\\p{Number}零〇一二三四五六七八九十百千万亿两壹贰叁肆伍陆柒捌玖拾佰仟萬億兆半廿卅]"}}},
                  "then": {"required": ["source"], "properties": {"source": {"type": "string", "pattern": "^\\s*假设\\s*[:：]\\s*\\S"}}}
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"episode": {"type": "object"}}},
      "then": {"properties": {"shots": {"items": {"$ref": "#/$defs/extendedShot"}}}},
      "else": {"properties": {"shots": {"items": {"$ref": "#/$defs/shot"}}}}
    }
  ]
}
