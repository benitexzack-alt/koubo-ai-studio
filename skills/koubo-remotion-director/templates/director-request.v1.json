            "items": [
              {"id": "n5", "label": "动作二", "role": "action"},
              {"id": "n6", "label": "证据二", "role": "evidence"}
            ]
          },
          {
            "id": "g4",
            "label": "路径三",
            "material": "压印纸签",
            "visualPrimitive": "comment-magnifier",
            "visualRole": "source-channel",
            "items": [
              {"id": "n7", "label": "动作三", "role": "action"},
              {"id": "n8", "label": "证据三", "role": "evidence"}
            ]
          },
          {
            "id": "g5",
            "label": "汇合",
