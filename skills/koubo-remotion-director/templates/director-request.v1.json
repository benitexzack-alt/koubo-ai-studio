        "assemblyStages": [
          {"id": "s1", "atSeconds": 0.2, "action": "建立承载面", "targetIds": ["g1"]},
          {"id": "s2", "atSeconds": 2.2, "action": "抽出", "targetIds": ["g2"]},
          {"id": "s3", "atSeconds": 4.4, "action": "展开", "targetIds": ["g3"]},
          {"id": "s4", "atSeconds": 6.6, "action": "盖章", "targetIds": ["g4"]},
          {"id": "s5", "atSeconds": 11, "action": "汇入", "targetIds": ["g5", "n9"]}
        ],
        "relations": [
          {"from": "g1", "to": "g2"},
          {"from": "g1", "to": "g3"},
          {"from": "g1", "to": "g4"},
          {"from": "g2", "to": "g5"},
