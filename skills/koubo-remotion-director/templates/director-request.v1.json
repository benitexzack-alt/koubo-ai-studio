{
  "schemaVersion": "koubo-director-request/v1",
  "templateOnly": true,
  "_instructions": [
    "复制本模板为任务级 request JSON；不要直接运行本模板。",
    "所有时间均为样片相对秒；spoken.sourceIn/sourceOut 才使用媒体自身秒码。",
    "本模板默认 execution.mode=plan-only；spoken 窗必须为20至30秒，render.durationSeconds、captions 和 semanticBeats 必须连续覆盖同一时长。",
    "plan-only 只允许生成 validate-plan 命令，samplePlan.outputs 必须为 null；不得生成或宣称任何渲染、静帧、A/B打包或正式生产命令。",
    "sha256 必须由当前真实文件计算，不接受占位值。",
    "complex-explanation 必须有5至6组、9至13节点、至少3层和至少5级装配。",
    "occluded-state-reveal 只在完全遮挡时切换已绑定状态；不得声称 mechanical-causality 或真实机械关节动画。",
    "摄影状态图、遮挡物、用户接受回执、监督门回执和状态包回执都必须使用绝对路径与当前 SHA-256；visual-state-package 逐项绑定 sceneId、receiptStateId 和 visualStateAssetId。",
    "录屏必须列出 excludedRanges；每张完成态必须列出 requiredStageIds 和至少30帧稳定时间。",
    "execution.runtimeContractId 必须保持 koubo-director-runtime-files/v1；runtimeFiles 必须逐项填写当前真实文件路径和当前 SHA-256，不得删除条目、重复ID、保留空数组或写成可自动派生。",
    "从 projectRoot 执行 shasum -a 256 -- <path> 逐文件计算 SHA-256；任何文件变化后必须重新计算并更新对应条目。",
    "下列清单必须且只能包含16项 plan-only 公共运行时绑定；schema-validator-engine 是实际执行的 Ajv 单文件闭包。不得加入 remotion-cli、chrome-headless-shell、ab-packager、ffmpeg-binary、ffprobe-binary 或任何 public-* 绑定。",
    "integrityAnchors 的三个路径固定为当前合同路径；三个 SHA-256 都必须在实例化任务请求时按当前真实文件重新计算，其中两个 registry SHA 还必须由独立环境锚点传入。",
    "如需进入 renderable，必须由独立授权建立新的请求 revision；不得就地把本 plan-only 请求改成渲染授权。"
  ],
  "requestId": "replace-with-task-id",
  "status": "candidate",
  "productionEligible": false,
  "projectRoot": "<ABSOLUTE_REPOSITORY_ROOT>",
  "reference": {
    "path": "<ABSOLUTE_APPROVED_REFERENCE_PATH>",
    "sha256": "<CURRENT_REFERENCE_SHA256>"
  },
  "style": {
    "id": "paper-editorial-constructive-narrative-v1",
    "path": "skills/koubo-remotion-director/references/paper-editorial-style.v1.json",
    "sha256": "<CURRENT_STYLE_FILE_SHA256>"
  },
  "authority": {
    "transcriptPath": "<ABSOLUTE_AUTHORITY_TRANSCRIPT_PATH>",
    "transcriptSha256": "<CURRENT_AUTHORITY_TRANSCRIPT_SHA256>",
    "timelineWindow": {
      "start": 0,
      "end": 30,
      "coordinateSystem": "authoritative-timeline"
    },
    "receipts": [
      {
        "id": "user-style-direction-acceptance",
        "kind": "user-style-direction-acceptance",
        "effect": "required-gate",
        "path": "<ABSOLUTE_USER_STYLE_ACCEPTANCE_RECEIPT_PATH>",
        "sha256": "<CURRENT_USER_STYLE_ACCEPTANCE_RECEIPT_SHA256>"
      },
      {
        "id": "supervisor-static-gate",
        "kind": "supervisor-static-gate",
        "effect": "required-gate",
        "path": "<ABSOLUTE_SUPERVISOR_STATIC_GATE_RECEIPT_PATH>",
        "sha256": "<CURRENT_SUPERVISOR_STATIC_GATE_RECEIPT_SHA256>"
      },
      {
        "id": "visual-state-package-receipt",
        "kind": "visual-state-package",
        "effect": "evidence-only",
        "path": "<ABSOLUTE_VISUAL_STATE_PACKAGE_RECEIPT_PATH>",
        "sha256": "<CURRENT_VISUAL_STATE_PACKAGE_RECEIPT_SHA256>",
        "bindings": [
          {
            "sceneId": "occluded-scene",
            "receiptStateId": "input-state",
            "visualStateAssetId": "state-base"
          },
          {
            "sceneId": "occluded-scene",
            "receiptStateId": "output-state",
            "visualStateAssetId": "state-revealed"
          },
          {
            "sceneId": "occluded-scene",
            "receiptStateId": "occluder-state",
            "visualStateAssetId": "state-occluder"
          }
        ]
      }
    ],
    "wordTimeToleranceSeconds": 0.35
  },
  "render": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "durationSeconds": 30,
    "publicDir": "<ABSOLUTE_PUBLIC_MEDIA_DIRECTORY>",
    "outputDirectory": "work/director-paper-editorial/<TASK_ID>/plan-only-output"
  },
  "media": {
    "spoken": {
      "path": "<ABSOLUTE_CANONICAL_PROXY_PATH>",
      "staticFileName": "spoken-30fps.mp4",
      "sha256": "<CURRENT_CANONICAL_PROXY_SHA256>",
      "sourceIn": 0,
      "sourceOut": 30,
      "authoritativeOriginal": {
        "path": "<ABSOLUTE_AUTHORITATIVE_ORIGINAL_PATH>",
        "sha256": "<CURRENT_AUTHORITATIVE_ORIGINAL_SHA256>"
      }
    },
    "screen": null,
    "sfx": [
      {
        "id": "paper-lock",
        "path": "<ABSOLUTE_SFX_PATH>",
        "staticFileName": "sfx-paper-lock.wav",
        "sha256": "<CURRENT_SFX_SHA256>",
        "cues": [
          {"id": "paper-lock-cue", "atSeconds": 23, "volume": 0.2}
        ]
      }
    ],
    "visualStateAssets": [
      {
        "id": "state-base",
        "path": "<ABSOLUTE_STATE_BASE_PATH>",
        "staticFileName": "state-base.png",
        "sha256": "<CURRENT_STATE_BASE_SHA256>",
        "role": "base-state"
      },
      {
        "id": "state-revealed",
        "path": "<ABSOLUTE_STATE_REVEALED_PATH>",
        "staticFileName": "state-revealed.png",
        "sha256": "<CURRENT_STATE_REVEALED_SHA256>",
        "role": "revealed-state"
      },
      {
        "id": "state-occluder",
        "path": "<ABSOLUTE_STATE_OCCLUDER_PATH>",
        "staticFileName": "state-occluder.png",
        "sha256": "<CURRENT_STATE_OCCLUDER_SHA256>",
        "role": "occluder"
      }
    ]
  },
  "captions": [
    {
      "id": "cue-001",
      "start": 0,
      "end": 15,
      "text": "替换为实录前半段复杂解释原句"
    },
    {
      "id": "cue-002",
      "start": 15,
      "end": 30,
      "text": "替换为实录后半段遮挡换态原句"
